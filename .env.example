NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://splitfinpulse:splitfinpulse@localhost:5433/splitfinpulse?schema=public
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
VITE_API_BASE_URL=http://localhost:3000
WEB_APP_URL=http://localhost:5173
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
AUTH_ISSUER=splitfinpulse
AUTH_AUDIENCE=splitfinpulse-web
AUTH_ACCESS_SECRET=replace-with-at-least-32-random-characters
AUTH_REFRESH_SECRET=replace-with-a-different-32-character-secret
OIDC_TRANSACTION_SECRET=replace-with-another-32-character-secret
FRIEND_INVITE_SECRET=replace-with-a-fourth-distinct-32-character-secret
AUTH_ACCESS_TTL_SECONDS=600
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_IDLE_TTL_SECONDS=604800
FRIEND_INVITE_TTL_SECONDS=604800
ATTACHMENT_STORAGE_ROOT=/tmp/splitfinpulse-attachments
ATTACHMENT_UPLOAD_SECRET=replace-with-a-fifth-distinct-32-character-secret
ATTACHMENT_MAX_BYTES=10485760
PUSH_TOKEN_SECRET=replace-with-a-sixth-distinct-32-character-secret
# Optional notification providers. Configure each provider as a complete set.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
