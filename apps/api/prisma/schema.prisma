generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DEACTIVATED
  DELETED
}

enum AuthProvider {
  GOOGLE
}

enum OidcIntent {
  LOGIN
  REAUTHENTICATE
  REACTIVATE
}

enum AccountLifecycleEventType {
  DATA_EXPORTED
  DEACTIVATED
  REACTIVATED
  DELETED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  REMOVED
}

enum GroupType {
  TRIP
  HOME
  COUPLE
  OTHER
}

enum GroupStatus {
  ACTIVE
  ARCHIVED
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ExpenseStatus {
  ACTIVE
  DELETED
}

enum ExpenseRevisionAction {
  CREATED
  UPDATED
  DELETED
  RESTORED
}

enum SplitMethod {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum LedgerSourceType {
  EXPENSE_REVISION
  SETTLEMENT_REVISION
}

enum SettlementStatus {
  ACTIVE
  REVERSED
}

enum SettlementRevisionAction {
  CREATED
  REPLACED
  REVERSED
}

enum SettlementMethod {
  CASH
  BANK_TRANSFER
  CARD
  OTHER
}

enum CategoryKind {
  SYSTEM
  USER
}

enum AttachmentStatus {
  PENDING
  AVAILABLE
  REJECTED
  DELETED
}

enum AttachmentScanStatus {
  PENDING
  NOT_CONFIGURED
  CLEAN
  REJECTED
}

enum ReceiptExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  NO_DATA
  FAILED
  UNSUPPORTED
}

enum ExchangeRateSetStatus {
  AVAILABLE
  MANUAL
  UNAVAILABLE
}

enum BackgroundJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
  CANCELED
}

enum RecurringExpenseStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum RecurrenceUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum RecurringOccurrenceStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum NotificationCategory {
  EXPENSE_ACTIVITY
  INVITATIONS
  REMINDERS
  BUDGET_ALERTS
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
  SUPPRESSED
}

enum PushPlatform {
  WEB
}

enum ReminderStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  SKIPPED
  FAILED
}

enum BudgetScope {
  PERSONAL
  CATEGORY
  GROUP
}

enum BudgetStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                        String                          @id @default(uuid()) @db.Uuid
  email                     String?                         @unique @db.VarChar(320)
  name                      String                          @db.VarChar(100)
  avatarUrl                 String?                         @db.VarChar(2048)
  providerAvatarUrl         String?                         @db.VarChar(2048)
  defaultCurrency           String                          @default("USD") @db.Char(3)
  timezone                  String                          @default("UTC") @db.VarChar(100)
  locale                    String                          @default("en-US") @db.VarChar(35)
  notifyExpenseActivity     Boolean                         @default(true)
  notifyReminders           Boolean                         @default(true)
  notifyInvitations         Boolean                         @default(true)
  notifyBudgetAlerts        Boolean                         @default(true)
  status                    UserStatus                      @default(ACTIVE)
  createdAt                 DateTime                        @default(now())
  updatedAt                 DateTime                        @updatedAt
  deactivatedAt             DateTime?
  deletedAt                 DateTime?
  identities                AuthIdentity[]
  deletedIdentities         DeletedAuthIdentity[]
  sessions                  AuthSession[]
  lifecycleEvents           AccountLifecycleEvent[]
  friendshipsAsFirst        Friendship[]                    @relation("FriendshipFirstUser")
  friendshipsAsSecond       Friendship[]                    @relation("FriendshipSecondUser")
  friendshipRequests        Friendship[]                    @relation("FriendshipRequester")
  invitationsCreated        FriendInvitation[]              @relation("InvitationInviter")
  invitationsAccepted       FriendInvitation[]              @relation("InvitationAcceptedBy")
  groupsCreated             Group[]                         @relation("GroupCreator")
  groupMemberships          GroupMember[]
  groupInvitations          GroupInvitation[]               @relation("GroupInvitationCreator")
  expensesCreated           Expense[]                       @relation("ExpenseCreator")
  expenseRevisionsMade      ExpenseRevision[]               @relation("ExpenseRevisionActor")
  expensePayerRows          ExpensePayer[]
  expenseSplitRows          ExpenseSplit[]
  ledgerDebts               LedgerEntry[]                   @relation("LedgerDebtor")
  ledgerCredits             LedgerEntry[]                   @relation("LedgerCreditor")
  expenseIdempotencies      ExpenseIdempotency[]
  settlementsCreated        Settlement[]                    @relation("SettlementCreator")
  settlementRevisionsMade   SettlementRevision[]            @relation("SettlementRevisionActor")
  settlementsFrom           SettlementRevision[]            @relation("SettlementFromUser")
  settlementsTo             SettlementRevision[]            @relation("SettlementToUser")
  settlementIdempotencies   SettlementIdempotency[]
  activityEvents            ActivityEvent[]                 @relation("ActivityActor")
  activityAudience          ActivityAudience[]
  expenseComments           ExpenseComment[]
  auditEvents               AuditEvent[]                    @relation("AuditActor")
  categories                Category[]
  attachmentsUploaded       Attachment[]
  uploadIntents             AttachmentUploadIntent[]
  exchangeRateSets          ExchangeRateSet[]
  recurringExpensesCreated  RecurringExpense[]              @relation("RecurringExpenseCreator")
  recurringExpenseRevisions RecurringExpenseRevision[]      @relation("RecurringExpenseRevisionActor")
  recurringExpensePayers    RecurringExpensePayer[]
  recurringExpenseSplits    RecurringExpenseSplit[]
  recurringIdempotencies    RecurringExpenseIdempotency[]
  notifications             Notification[]                  @relation("NotificationRecipient")
  notificationsActed        Notification[]                  @relation("NotificationActor")
  notificationPreferences   NotificationChannelPreference[]
  pushDevices               PushDevice[]
  remindersSent             Reminder[]                      @relation("ReminderSender")
  remindersReceived         Reminder[]                      @relation("ReminderRecipient")
  budgetsCreated            Budget[]                        @relation("BudgetCreator")
  personalBudgets           Budget[]                        @relation("BudgetOwner")

  @@index([status])
}

model Group {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String             @db.VarChar(100)
  type                 GroupType
  status               GroupStatus        @default(ACTIVE)
  defaultCurrency      String             @db.Char(3)
  simplifyDebtsEnabled Boolean            @default(false)
  createdById          String             @db.Uuid
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  archivedAt           DateTime?
  createdBy            User               @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  memberships          GroupMember[]
  invitations          GroupInvitation[]
  expenses             Expense[]
  settlements          Settlement[]
  recurringExpenses    RecurringExpense[]
  reminders            Reminder[]
  budgets              Budget[]

  @@index([status, updatedAt, id])
  @@index([createdById])
}

model GroupMember {
  id        String          @id @default(uuid()) @db.Uuid
  groupId   String          @db.Uuid
  userId    String          @db.Uuid
  role      GroupMemberRole @default(MEMBER)
  joinedAt  DateTime        @default(now())
  leftAt    DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  group     Group           @relation(fields: [groupId], references: [id], onDelete: Restrict)
  user      User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([groupId, leftAt, updatedAt, id])
  @@index([userId, leftAt, updatedAt, id])
}

model GroupInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  groupId     String    @db.Uuid
  createdById String    @db.Uuid
  tokenDigest String    @unique @db.Char(64)
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  group       Group     @relation(fields: [groupId], references: [id], onDelete: Restrict)
  createdBy   User      @relation("GroupInvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt, id])
  @@index([createdById])
  @@index([expiresAt])
}

model Friendship {
  id                String             @id @default(uuid()) @db.Uuid
  firstUserId       String             @db.Uuid
  secondUserId      String             @db.Uuid
  requestedById     String             @db.Uuid
  status            FriendshipStatus   @default(PENDING)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  acceptedAt        DateTime?
  declinedAt        DateTime?
  removedAt         DateTime?
  firstUser         User               @relation("FriendshipFirstUser", fields: [firstUserId], references: [id], onDelete: Restrict)
  secondUser        User               @relation("FriendshipSecondUser", fields: [secondUserId], references: [id], onDelete: Restrict)
  requestedBy       User               @relation("FriendshipRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  expenses          Expense[]
  settlements       Settlement[]
  activityEvents    ActivityEvent[]
  recurringExpenses RecurringExpense[]
  reminders         Reminder[]

  @@unique([firstUserId, secondUserId])
  @@index([firstUserId, status, updatedAt, id])
  @@index([secondUserId, status, updatedAt, id])
  @@index([requestedById, status, updatedAt, id])
}

model Expense {
  id                    String                 @id @default(uuid()) @db.Uuid
  creatorId             String                 @db.Uuid
  groupId               String?                @db.Uuid
  friendshipId          String?                @db.Uuid
  status                ExpenseStatus          @default(ACTIVE)
  version               Int                    @default(1)
  currentRevisionId     String?                @unique @db.Uuid
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  creator               User                   @relation("ExpenseCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  group                 Group?                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  friendship            Friendship?            @relation(fields: [friendshipId], references: [id], onDelete: Restrict)
  revisions             ExpenseRevision[]      @relation("ExpenseRevisions")
  currentRevision       ExpenseRevision?       @relation("CurrentExpenseRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  idempotencies         ExpenseIdempotency[]
  comments              ExpenseComment[]
  attachments           Attachment[]
  settlementAllocations SettlementAllocation[]
  recurringOccurrences  RecurringOccurrence[]

  @@index([groupId, status, updatedAt, id])
  @@index([friendshipId, status, updatedAt, id])
  @@index([creatorId, updatedAt, id])
}

model ExpenseRevision {
  id                String                @id @default(uuid()) @db.Uuid
  expenseId         String                @db.Uuid
  revision          Int
  action            ExpenseRevisionAction
  actorId           String                @db.Uuid
  description       String                @db.VarChar(200)
  totalMinor        BigInt
  currency          String                @db.Char(3)
  expenseDate       DateTime              @db.Date
  notes             String?               @db.VarChar(2000)
  splitMethod       SplitMethod
  categoryId        String?               @db.Uuid
  categoryName      String?               @db.VarChar(80)
  categoryIcon      String?               @db.VarChar(40)
  exchangeRateSetId String?               @db.Uuid
  createdAt         DateTime              @default(now())
  expense           Expense               @relation("ExpenseRevisions", fields: [expenseId], references: [id], onDelete: Restrict)
  currentFor        Expense?              @relation("CurrentExpenseRevision")
  actor             User                  @relation("ExpenseRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  payers            ExpensePayer[]
  splits            ExpenseSplit[]
  ledgerEntries     LedgerEntry[]
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  exchangeRateSet   ExchangeRateSet?      @relation(fields: [exchangeRateSetId], references: [id], onDelete: Restrict)

  @@unique([expenseId, revision])
  @@index([expenseId, createdAt, id])
  @@index([actorId])
  @@index([categoryId, expenseDate])
  @@index([exchangeRateSetId])
}

model ExpensePayer {
  id          String          @id @default(uuid()) @db.Uuid
  revisionId  String          @db.Uuid
  userId      String          @db.Uuid
  amountMinor BigInt
  revision    ExpenseRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([revisionId, userId])
  @@index([userId, revisionId])
}

model ExpenseSplit {
  id          String          @id @default(uuid()) @db.Uuid
  revisionId  String          @db.Uuid
  userId      String          @db.Uuid
  amountMinor BigInt
  inputValue  String?         @db.VarChar(40)
  revision    ExpenseRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user        User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([revisionId, userId])
  @@index([userId, revisionId])
}

model LedgerEntry {
  id                   String              @id @default(uuid()) @db.Uuid
  sourceType           LedgerSourceType
  expenseRevisionId    String?             @map("revisionId") @db.Uuid
  settlementRevisionId String?             @db.Uuid
  sequence             Int
  debtorId             String              @db.Uuid
  creditorId           String              @db.Uuid
  amountMinor          BigInt
  currency             String              @db.Char(3)
  createdAt            DateTime            @default(now())
  revision             ExpenseRevision?    @relation(fields: [expenseRevisionId], references: [id], onDelete: Restrict)
  settlementRevision   SettlementRevision? @relation(fields: [settlementRevisionId], references: [id], onDelete: Restrict)
  debtor               User                @relation("LedgerDebtor", fields: [debtorId], references: [id], onDelete: Restrict)
  creditor             User                @relation("LedgerCreditor", fields: [creditorId], references: [id], onDelete: Restrict)

  @@unique([expenseRevisionId, sequence])
  @@unique([settlementRevisionId, sequence])
  @@index([debtorId, currency])
  @@index([creditorId, currency])
}

model Settlement {
  id                   String                  @id @default(uuid()) @db.Uuid
  creatorId            String                  @db.Uuid
  groupId              String?                 @db.Uuid
  friendshipId         String?                 @db.Uuid
  status               SettlementStatus        @default(ACTIVE)
  version              Int                     @default(1)
  currentRevisionId    String?                 @unique @db.Uuid
  replacesSettlementId String?                 @unique @db.Uuid
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  reversedAt           DateTime?
  creator              User                    @relation("SettlementCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  group                Group?                  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  friendship           Friendship?             @relation(fields: [friendshipId], references: [id], onDelete: Restrict)
  revisions            SettlementRevision[]    @relation("SettlementRevisions")
  currentRevision      SettlementRevision?     @relation("CurrentSettlementRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  idempotencies        SettlementIdempotency[]
  replaces             Settlement?             @relation("SettlementReplacement", fields: [replacesSettlementId], references: [id], onDelete: Restrict)
  replacement          Settlement?             @relation("SettlementReplacement")

  @@index([groupId, status, updatedAt, id])
  @@index([friendshipId, status, updatedAt, id])
  @@index([creatorId, updatedAt, id])
}

model SettlementRevision {
  id                String                   @id @default(uuid()) @db.Uuid
  settlementId      String                   @db.Uuid
  revision          Int
  action            SettlementRevisionAction
  actorId           String                   @db.Uuid
  fromUserId        String                   @db.Uuid
  toUserId          String                   @db.Uuid
  amountMinor       BigInt
  currency          String                   @db.Char(3)
  method            SettlementMethod
  methodLabel       String?                  @db.VarChar(80)
  settledOn         DateTime                 @db.Date
  note              String?                  @db.VarChar(2000)
  reversalReason    String?                  @db.VarChar(500)
  exchangeRateSetId String?                  @db.Uuid
  createdAt         DateTime                 @default(now())
  settlement        Settlement               @relation("SettlementRevisions", fields: [settlementId], references: [id], onDelete: Restrict)
  currentFor        Settlement?              @relation("CurrentSettlementRevision")
  actor             User                     @relation("SettlementRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  fromUser          User                     @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser            User                     @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  ledgerEntries     LedgerEntry[]
  allocations       SettlementAllocation[]
  exchangeRateSet   ExchangeRateSet?         @relation(fields: [exchangeRateSetId], references: [id], onDelete: Restrict)

  @@unique([settlementId, revision])
  @@index([settlementId, createdAt, id])
  @@index([fromUserId, currency])
  @@index([toUserId, currency])
  @@index([exchangeRateSetId])
}

model Category {
  id         String            @id @default(uuid()) @db.Uuid
  kind       CategoryKind
  ownerId    String?           @db.Uuid
  key        String            @db.VarChar(50)
  name       String            @db.VarChar(80)
  icon       String            @db.VarChar(40)
  archivedAt DateTime?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  owner      User?             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  revisions  ExpenseRevision[]
  budgets    Budget[]

  @@unique([ownerId, key])
  @@index([kind, archivedAt, name])
}

model SettlementAllocation {
  id                   String             @id @default(uuid()) @db.Uuid
  settlementRevisionId String             @db.Uuid
  expenseId            String             @db.Uuid
  pathSequence         Int
  edgeSequence         Int
  debtorId             String             @db.Uuid
  creditorId           String             @db.Uuid
  currency             String             @db.Char(3)
  amountMinor          BigInt
  createdAt            DateTime           @default(now())
  settlementRevision   SettlementRevision @relation(fields: [settlementRevisionId], references: [id], onDelete: Restrict)
  expense              Expense            @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([settlementRevisionId, pathSequence, edgeSequence])
  @@index([expenseId, currency])
  @@index([settlementRevisionId])
}

model Attachment {
  id           String                  @id @default(uuid()) @db.Uuid
  expenseId    String?                 @db.Uuid
  uploaderId   String                  @db.Uuid
  originalName String                  @db.VarChar(255)
  storageKey   String?                 @unique @db.VarChar(100)
  declaredMime String                  @db.VarChar(100)
  detectedMime String?                 @db.VarChar(100)
  sizeBytes    Int?
  sha256       String?                 @db.Char(64)
  status       AttachmentStatus        @default(PENDING)
  scanStatus   AttachmentScanStatus    @default(PENDING)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  deletedAt    DateTime?
  uploader     User                    @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  expense      Expense?                @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  uploadIntent AttachmentUploadIntent?
  extraction   ReceiptExtraction?

  @@index([expenseId, status, createdAt])
  @@index([uploaderId, expenseId, createdAt])
}

model AttachmentUploadIntent {
  id           String     @id @default(uuid()) @db.Uuid
  attachmentId String     @unique @db.Uuid
  uploaderId   String     @db.Uuid
  tokenDigest  String     @unique @db.Char(64)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())
  attachment   Attachment @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  uploader     User       @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([uploaderId, createdAt])
}

model ReceiptExtraction {
  id             String                  @id @default(uuid()) @db.Uuid
  attachmentId   String                  @unique @db.Uuid
  status         ReceiptExtractionStatus @default(PENDING)
  attempts       Int                     @default(0)
  leaseOwner     String?                 @db.VarChar(100)
  leaseExpiresAt DateTime?
  nextAttemptAt  DateTime                @default(now())
  merchant       String?                 @db.VarChar(200)
  expenseDate    DateTime?               @db.Date
  totalText      String?                 @db.VarChar(80)
  currencyHint   String?                 @db.Char(3)
  confidence     String?                 @db.VarChar(20)
  errorCode      String?                 @db.VarChar(80)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  attachment     Attachment              @relation(fields: [attachmentId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, leaseExpiresAt])
}

model ExchangeRateSet {
  id                  String                @id @default(uuid()) @db.Uuid
  baseCurrency        String                @db.Char(3)
  status              ExchangeRateSetStatus
  source              String                @db.VarChar(80)
  effectiveDate       DateTime              @db.Date
  capturedAt          DateTime              @default(now())
  payloadHash         String?               @db.Char(64)
  createdById         String?               @db.Uuid
  expiresAt           DateTime?
  createdBy           User?                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  quotes              ExchangeRateQuote[]
  expenseRevisions    ExpenseRevision[]
  settlementRevisions SettlementRevision[]

  @@index([baseCurrency, effectiveDate, capturedAt])
  @@index([createdById, expiresAt])
}

model ExchangeRateQuote {
  id            String          @id @default(uuid()) @db.Uuid
  rateSetId     String          @db.Uuid
  quoteCurrency String          @db.Char(3)
  numerator     String          @db.VarChar(80)
  denominator   String          @db.VarChar(80)
  rateSet       ExchangeRateSet @relation(fields: [rateSetId], references: [id], onDelete: Restrict)

  @@unique([rateSetId, quoteCurrency])
  @@index([quoteCurrency])
}

model SettlementIdempotency {
  id           String     @id @default(uuid()) @db.Uuid
  actorId      String     @db.Uuid
  operation    String     @db.VarChar(32)
  key          String     @db.VarChar(128)
  requestHash  String     @db.Char(64)
  settlementId String     @db.Uuid
  createdAt    DateTime   @default(now())
  actor        User       @relation(fields: [actorId], references: [id], onDelete: Restrict)
  settlement   Settlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
  @@index([settlementId])
}

model ActivityEvent {
  id             String             @id @default(uuid()) @db.Uuid
  type           String             @db.VarChar(80)
  actorId        String?            @db.Uuid
  entityType     String             @db.VarChar(40)
  entityId       String             @db.Uuid
  groupId        String?            @db.Uuid
  friendshipId   String?            @db.Uuid
  payloadVersion Int                @default(1)
  payload        Json
  occurredAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())
  actor          User?              @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  friendship     Friendship?        @relation(fields: [friendshipId], references: [id], onDelete: Restrict)
  audiences      ActivityAudience[]

  @@index([groupId, occurredAt, id])
  @@index([friendshipId, occurredAt, id])
  @@index([entityType, entityId])
}

model ActivityAudience {
  id        String        @id @default(uuid()) @db.Uuid
  eventId   String        @db.Uuid
  userId    String        @db.Uuid
  createdAt DateTime      @default(now())
  event     ActivityEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([eventId, userId])
  @@index([userId, eventId])
}

model ExpenseComment {
  id        String    @id @default(uuid()) @db.Uuid
  expenseId String    @db.Uuid
  authorId  String    @db.Uuid
  body      String?   @db.VarChar(2000)
  version   Int       @default(1)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  expense   Expense   @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([expenseId, createdAt, id])
  @@index([authorId])
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  sessionId  String?  @db.Uuid
  action     String   @db.VarChar(80)
  targetType String   @db.VarChar(40)
  targetId   String?  @db.Uuid
  outcome    String   @default("SUCCESS") @db.VarChar(20)
  requestId  String?  @db.VarChar(128)
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt, id])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

model ExpenseIdempotency {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String   @db.Uuid
  operation   String   @db.VarChar(32)
  key         String   @db.VarChar(128)
  requestHash String   @db.Char(64)
  expenseId   String   @db.Uuid
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
  @@index([expenseId])
}

model FriendInvitation {
  id           String    @id @default(uuid()) @db.Uuid
  inviterId    String    @db.Uuid
  tokenDigest  String    @unique @db.Char(64)
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  acceptedById String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inviter      User      @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Restrict)
  acceptedBy   User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict)

  @@index([inviterId, createdAt])
  @@index([expiresAt])
  @@index([acceptedById])
}

model DeletedAuthIdentity {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  provider    AuthProvider
  subjectHash String       @db.Char(64)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, subjectHash])
  @@index([userId])
}

model AuthIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  provider        AuthProvider
  providerSubject String       @db.VarChar(255)
  providerEmail   String       @db.VarChar(320)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
}

model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  refreshTokenHash  String    @db.Char(64)
  tokenVersion      Int       @default(1)
  deviceDescription String    @db.VarChar(160)
  absoluteExpiresAt DateTime
  idleExpiresAt     DateTime
  lastUsedAt        DateTime  @default(now())
  reauthenticatedAt DateTime  @default(now())
  revokedAt         DateTime?
  revokedReason     String?   @db.VarChar(80)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([absoluteExpiresAt])
}

model OidcTransaction {
  id           String     @id @default(uuid()) @db.Uuid
  stateHash    String     @unique @db.Char(64)
  codeVerifier String     @db.VarChar(512)
  nonce        String     @db.VarChar(128)
  intent       OidcIntent @default(LOGIN)
  returnTo     String     @db.VarChar(500)
  sessionId    String?    @db.Uuid
  expiresAt    DateTime
  createdAt    DateTime   @default(now())

  @@index([expiresAt])
}

model AccountLifecycleEvent {
  id        String                    @id @default(uuid()) @db.Uuid
  userId    String                    @db.Uuid
  type      AccountLifecycleEventType
  createdAt DateTime                  @default(now())
  user      User                      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model BackgroundJob {
  id             String              @id @default(uuid()) @db.Uuid
  type           String              @db.VarChar(80)
  payloadVersion Int                 @default(1)
  payload        Json
  dedupeKey      String              @unique @db.VarChar(200)
  status         BackgroundJobStatus @default(PENDING)
  runAt          DateTime            @default(now())
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(5)
  leaseOwner     String?             @db.VarChar(100)
  leaseExpiresAt DateTime?
  lastErrorCode  String?             @db.VarChar(80)
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([status, runAt, leaseExpiresAt, id])
  @@index([type, status, runAt])
}

model RecurringExpense {
  id                String                        @id @default(uuid()) @db.Uuid
  creatorId         String                        @db.Uuid
  groupId           String?                       @db.Uuid
  friendshipId      String?                       @db.Uuid
  status            RecurringExpenseStatus        @default(ACTIVE)
  version           Int                           @default(1)
  currentRevisionId String?                       @unique @db.Uuid
  nextRunAt         DateTime?
  pausedAt          DateTime?
  completedAt       DateTime?
  archivedAt        DateTime?
  lastFailureCode   String?                       @db.VarChar(80)
  lastFailureAt     DateTime?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  creator           User                          @relation("RecurringExpenseCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  group             Group?                        @relation(fields: [groupId], references: [id], onDelete: Restrict)
  friendship        Friendship?                   @relation(fields: [friendshipId], references: [id], onDelete: Restrict)
  revisions         RecurringExpenseRevision[]    @relation("RecurringExpenseRevisions")
  currentRevision   RecurringExpenseRevision?     @relation("CurrentRecurringExpenseRevision", fields: [currentRevisionId], references: [id], onDelete: Restrict)
  occurrences       RecurringOccurrence[]
  idempotencies     RecurringExpenseIdempotency[]

  @@index([status, nextRunAt, id])
  @@index([creatorId, updatedAt, id])
  @@index([groupId, status, updatedAt])
  @@index([friendshipId, status, updatedAt])
}

model RecurringExpenseRevision {
  id                 String                  @id @default(uuid()) @db.Uuid
  recurringExpenseId String                  @db.Uuid
  revision           Int
  actorId            String                  @db.Uuid
  description        String                  @db.VarChar(200)
  totalMinor         BigInt
  currency           String                  @db.Char(3)
  notes              String?                 @db.VarChar(2000)
  splitMethod        SplitMethod
  categoryId         String?                 @db.Uuid
  recurrenceUnit     RecurrenceUnit
  recurrenceInterval Int
  weekdays           Int[]
  anchorDate         DateTime                @db.Date
  localTime          String                  @db.Char(5)
  timezone           String                  @db.VarChar(100)
  endDate            DateTime?               @db.Date
  createdAt          DateTime                @default(now())
  recurringExpense   RecurringExpense        @relation("RecurringExpenseRevisions", fields: [recurringExpenseId], references: [id], onDelete: Restrict)
  currentFor         RecurringExpense?       @relation("CurrentRecurringExpenseRevision")
  actor              User                    @relation("RecurringExpenseRevisionActor", fields: [actorId], references: [id], onDelete: Restrict)
  payers             RecurringExpensePayer[]
  splits             RecurringExpenseSplit[]
  occurrences        RecurringOccurrence[]

  @@unique([recurringExpenseId, revision])
  @@index([actorId])
  @@index([categoryId])
}

model RecurringExpensePayer {
  id          String                   @id @default(uuid()) @db.Uuid
  revisionId  String                   @db.Uuid
  userId      String                   @db.Uuid
  amountMinor BigInt
  revision    RecurringExpenseRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([revisionId, userId])
  @@index([userId, revisionId])
}

model RecurringExpenseSplit {
  id          String                   @id @default(uuid()) @db.Uuid
  revisionId  String                   @db.Uuid
  userId      String                   @db.Uuid
  amountMinor BigInt
  inputValue  String?                  @db.VarChar(40)
  revision    RecurringExpenseRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  user        User                     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([revisionId, userId])
  @@index([userId, revisionId])
}

model RecurringOccurrence {
  id                 String                    @id @default(uuid()) @db.Uuid
  recurringExpenseId String                    @db.Uuid
  revisionId         String                    @db.Uuid
  occurrenceKey      String                    @db.VarChar(80)
  localDate          DateTime                  @db.Date
  scheduledFor       DateTime
  status             RecurringOccurrenceStatus @default(PENDING)
  attempts           Int                       @default(0)
  expenseId          String?                   @unique @db.Uuid
  lastErrorCode      String?                   @db.VarChar(80)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  recurringExpense   RecurringExpense          @relation(fields: [recurringExpenseId], references: [id], onDelete: Restrict)
  revision           RecurringExpenseRevision  @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  expense            Expense?                  @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  @@unique([recurringExpenseId, occurrenceKey])
  @@index([status, scheduledFor, id])
  @@index([recurringExpenseId, scheduledFor, id])
}

model RecurringExpenseIdempotency {
  id                 String           @id @default(uuid()) @db.Uuid
  actorId            String           @db.Uuid
  operation          String           @db.VarChar(32)
  key                String           @db.VarChar(128)
  requestHash        String           @db.Char(64)
  recurringExpenseId String           @db.Uuid
  createdAt          DateTime         @default(now())
  actor              User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  recurringExpense   RecurringExpense @relation(fields: [recurringExpenseId], references: [id], onDelete: Restrict)

  @@unique([actorId, operation, key])
  @@index([recurringExpenseId])
}

model Notification {
  id             String                 @id @default(uuid()) @db.Uuid
  recipientId    String                 @db.Uuid
  actorId        String?                @db.Uuid
  category       NotificationCategory
  type           String                 @db.VarChar(80)
  sourceType     String                 @db.VarChar(40)
  sourceId       String                 @db.VarChar(100)
  targetType     String?                @db.VarChar(40)
  targetId       String?                @db.Uuid
  dedupeKey      String                 @db.VarChar(200)
  payloadVersion Int                    @default(1)
  payload        Json
  inAppVisible   Boolean                @default(true)
  occurredAt     DateTime               @default(now())
  readAt         DateTime?
  createdAt      DateTime               @default(now())
  recipient      User                   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  actor          User?                  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  deliveries     NotificationDelivery[]

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, readAt, occurredAt, id])
  @@index([sourceType, sourceId])
}

model NotificationChannelPreference {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  category  NotificationCategory
  channel   NotificationChannel
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  user      User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, category, channel])
  @@index([userId, category])
}

model PushDevice {
  id               String                 @id @default(uuid()) @db.Uuid
  userId           String                 @db.Uuid
  sessionId        String                 @db.Uuid
  platform         PushPlatform           @default(WEB)
  tokenCiphertext  String                 @db.Text
  tokenFingerprint String                 @unique @db.Char(64)
  lastSeenAt       DateTime               @default(now())
  retiredAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries       NotificationDelivery[]

  @@index([userId, retiredAt, lastSeenAt])
  @@index([sessionId, retiredAt])
}

model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  notificationId    String                     @db.Uuid
  channel           NotificationChannel
  deviceId          String?                    @db.Uuid
  status            NotificationDeliveryStatus @default(PENDING)
  attempts          Int                        @default(0)
  nextAttemptAt     DateTime                   @default(now())
  providerMessageId String?                    @db.VarChar(200)
  lastErrorCode     String?                    @db.VarChar(80)
  sentAt            DateTime?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  device            PushDevice?                @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel, deviceId])
  @@index([status, nextAttemptAt, id])
}

model Reminder {
  id                   String         @id @default(uuid()) @db.Uuid
  senderId             String         @db.Uuid
  recipientId          String         @db.Uuid
  groupId              String?        @db.Uuid
  friendshipId         String?        @db.Uuid
  currency             String         @db.Char(3)
  outstandingMinor     BigInt
  processedAmountMinor BigInt?
  scheduledFor         DateTime
  status               ReminderStatus @default(SCHEDULED)
  outcomeCode          String?        @db.VarChar(80)
  processedAt          DateTime?
  canceledAt           DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  sender               User           @relation("ReminderSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient            User           @relation("ReminderRecipient", fields: [recipientId], references: [id], onDelete: Restrict)
  group                Group?         @relation(fields: [groupId], references: [id], onDelete: Restrict)
  friendship           Friendship?    @relation(fields: [friendshipId], references: [id], onDelete: Restrict)

  @@index([senderId, createdAt, id])
  @@index([recipientId, createdAt, id])
  @@index([status, scheduledFor, id])
}

model Budget {
  id          String                 @id @default(uuid()) @db.Uuid
  creatorId   String                 @db.Uuid
  ownerId     String?                @db.Uuid
  groupId     String?                @db.Uuid
  categoryId  String?                @db.Uuid
  scope       BudgetScope
  currency    String                 @db.Char(3)
  amountMinor BigInt
  startMonth  DateTime               @db.Date
  endMonth    DateTime?              @db.Date
  status      BudgetStatus           @default(ACTIVE)
  version     Int                    @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  archivedAt  DateTime?
  creator     User                   @relation("BudgetCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  owner       User?                  @relation("BudgetOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  group       Group?                 @relation(fields: [groupId], references: [id], onDelete: Restrict)
  category    Category?              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  thresholds  BudgetThresholdEvent[]

  @@index([ownerId, status, currency])
  @@index([groupId, status, currency])
  @@index([categoryId, status, currency])
}

model BudgetThresholdEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  budgetId           String   @db.Uuid
  month              DateTime @db.Date
  thresholdPercent   Int
  observedSpendMinor BigInt
  notificationId     String?  @db.Uuid
  createdAt          DateTime @default(now())
  budget             Budget   @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  @@unique([budgetId, month, thresholdPercent])
  @@index([month, createdAt])
}
